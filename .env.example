# Copy this file to .env in the project root before running docker compose.
# These values are shared across services via docker-compose.yml's
# environment: blocks — JWT_ACCESS_SECRET in particular MUST be
# identical everywhere or tokens minted by auth-service will fail
# verification in user-service, ticket-service, and the gateway.

DB_PASSWORD=change_me_use_a_real_secret

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
JWT_REFRESH_SECRET=replace_with_a_different_openssl_rand_base64_48

CORS_ORIGIN=http://localhost:3000
