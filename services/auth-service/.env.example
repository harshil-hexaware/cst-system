NODE_ENV=development
PORT=4001

DB_HOST=postgres
DB_PORT=5432
DB_NAME=cst_system
DB_USER=postgres
DB_PASSWORD=change_me_in_secrets_manager

JWT_ACCESS_SECRET=replace_with_openssl_rand_base64_48
