{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "Authentication & authorization microservice — JWT issuance, refresh tokens, password lifecycle, RBAC identity source.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "test": "mocha tests/**/*.test.js --timeout 10000 --exit",
    "test:coverage": "nyc --reporter=text --reporter=lcov --check-coverage --lines 80 npm test",
    "lint": "eslint src"
  },
  "dependencies": {
    "express": "^4.19.2",
    "sequelize": "^6.37.3",
    "pg": "^8.11.5",
    "pg-hstore": "^2.3.4",
    "bcrypt": "^5.1.1",
    "jsonwebtoken": "^9.0.2",
    "joi": "^17.13.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.2.0",
    "winston": "^3.13.0",
    "morgan": "^1.10.0",
    "amqplib": "^0.10.4",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "mocha": "^10.4.0",
    "chai": "^4.4.1",
    "chai-http": "^4.4.0",
    "sinon": "^17.0.2",
    "nyc": "^15.1.0",
    "nodemon": "^3.1.0",
    "eslint": "^8.57.0"
  },
  "engines": { "node": ">=18.0.0" }
}
